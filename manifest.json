{
  "manifest_version": 3,
  "name": "Unblock",
  "short_name": "Unblock",
  "version": "1.0.0",
  "description": "Lightweight, privacy-first content blocker. MV3-optimized with element picker, advanced cosmetic filtering, and anti-adblock mitigations.",
  "author": "Unblock Project",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/state.js",
        "js/scriptlets.js",
        "js/cosmetic-advanced.js",
        "js/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default-block",
        "enabled": true,
        "path": "rules/default-block.json"
      },
      {
        "id": "ads-lists-lite",
        "enabled": true,
        "path": "rules/ads-lite.json"
      },
      {
        "id": "privacy-lite",
        "enabled": true,
        "path": "rules/privacy-lite.json"
      },
      {
        "id": "trackers-lite",
        "enabled": true,
        "path": "rules/trackers-lite.json"
      }
    ]
  },
  "options_page": "ui/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "js/picker.js",
        "css/picker.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
